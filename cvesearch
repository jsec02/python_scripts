#!/usr/bin/env python

# ================================================================================
# =                                  CVESEARCH                                   =
# ================================================================================

# Queries NVD vulnerabilitity and GitHub repository APIs for provided CVEs
# Pulls data and heuristically ranks CVEs by popularity while displaying CVE scores
# This script is useful when combined with exploit suggestors

# An example workflow might be:
# wes systeminfo.txt -i "Elevation of Privilege" --exploits-only -o exploits.txt
# tail -n +2 exploits.txt | awk -F ',' '{print $2}' | tr -d '"' > cves.txt
# cvesearch cves.txt > ordered_cves.txt

import argparse
import time

import requests


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser()
    parser.add_argument("file", help="Path to file with CVE IDs")
    args = parser.parse_args()

    return args


def read_file(file: str) -> list[str]:
    with open(file) as f:
        cves = [cve.strip() for cve in f]

    # Deduplicate
    return list(set(cves))


def query_nvd_api(cve: str) -> dict[str, float | None]:
    headers = {
        "Accept": "text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8"
    }
    response = requests.get(
        url=f"https://services.nvd.nist.gov/rest/json/cves/2.0?cveIds={cve}",
        headers=headers,
    )

    data = response.json()

    if "totalResults" not in data:
        message = data.get("message", "Unknown error")
        raise RuntimeError(f"NVD API error: {message}")

    if data["totalResults"] < 1:
        return {
            "base_score": None,
            "exploitability_score": None,
            "impact_score": None,
        }

    base_score = data["vulnerabilities"][0]["cve"]["metrics"]["cvssMetricV2"][0][
        "cvssData"
    ]["baseScore"]
    exploitability_score = data["vulnerabilities"][0]["cve"]["metrics"]["cvssMetricV2"][
        0
    ]["exploitabilityScore"]
    impact_score = data["vulnerabilities"][0]["cve"]["metrics"]["cvssMetricV2"][0][
        "impactScore"
    ]

    return {
        "base_score": base_score,
        "exploitability_score": exploitability_score,
        "impact_score": impact_score,
    }


def query_github_api(cve: str) -> dict[str, int | None]:
    headers = {"Accept": "application/vnd.github+json"}
    response = requests.get(
        url=f"https://api.github.com/search/repositories?q={cve}&sort=stars",
        headers=headers,
    )

    data = response.json()

    if "total_count" not in data:
        message = data.get("message", "Unknown error")
        raise RuntimeError(f"GitHub API error: {message}")

    repositories = data["total_count"]

    try:
        # Previously sorted by stars desc from the api
        highest_stars = data["items"][0]["stargazers_count"]
    except IndexError:
        highest_stars = None

    return {
        "repositories": repositories,
        "highest_stars": highest_stars,
    }


def query(cves: list[str]) -> list[dict[str, str | int | None]]:
    aggregated = []

    for cve in cves:
        nvd_data = query_nvd_api(cve)
        github_data = query_github_api(cve)

        aggregated.append(
            {
                "CVE": cve,
                "base_score": nvd_data["base_score"],
                "exploitability_score": nvd_data["exploitability_score"],
                "impact_score": nvd_data["impact_score"],
                "repositories": github_data["repositories"],
                "highest_stars": github_data["highest_stars"],
            }
        )

        time.sleep(6)

    # Sort by total_count desc
    aggregated.sort(key=lambda cve: cve["repositories"] or 0, reverse=True)

    return aggregated


def print_results(aggregated: list[dict[str, str | int | None]]) -> None:
    for cve in aggregated:
        print(cve["CVE"])
        print(f"  Repositories: {cve['repositories']}")
        print(f"  Highest stars: {cve['highest_stars']}")
        print(f"  Base Score: {cve['base_score']}")
        print(f"  Exploitability score: {cve['exploitability_score']}")
        print(f"  Impact score: {cve['impact_score']}")
        print()


def main():
    args = parse_args()
    cves = read_file(args.file)
    aggregated = query(cves)
    print_results(aggregated)


if __name__ == "__main__":
    main()
