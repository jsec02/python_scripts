#!/usr/bin/env python

# ================================================================================
# =                                  CVESEARCH                                   =
# ================================================================================

# Queries NVD vulnerabilitity and GitHub repository APIs for provided CVEs
# Pulls data and heuristically ranks CVEs by popularity while displaying CVE scores
# This script is useful when combined with exploit suggestors

# An example workflow might be:
# wes systeminfo.txt -i "Elevation of Privilege" --exploits-only -o exploits.txt
# tail -n +2 exploits.txt | awk -F ',' '{print $2}' | tr -d '"' > cves.txt
# cvesearch cves.txt > ordered_cves.txt

import argparse
import re
import time

import requests


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser()
    parser.add_argument("file", help="Path to file with CVE IDs")
    args = parser.parse_args()

    return args


def read_file(file: str) -> list:
    with open(file) as f:
        cves = {cve.strip() for cve in f}  # Deduplicate

    return list(cves)


def query_nvd_api(query: str) -> dict:
    response = requests.get(
        url="https://services.nvd.nist.gov/rest/json/cves/2.0",
        params={"cveId": query},
        headers={"Accept": "application/json"},
        timeout=30,
    )
    response.raise_for_status()

    data = response.json()

    if "message" in data:
        raise RuntimeError(f"NVD API error: {data['message']}")

    result: dict[str, str | float | None] = {
        "security_bulletin": None,
        "base_score": None,
        "exploitability_score": None,
        "impact_score": None,
    }

    if data["totalResults"] < 1:
        return result

    vulnerability = data["vulnerabilities"][0]["cve"]

    regex = re.compile(r"ms\d{2}-\d{3}", re.IGNORECASE)
    for reference in vulnerability.get("references", []):
        if reference.get("source") != "secure@microsoft.com":
            continue
        match = regex.search(reference.get("url", ""))
        if match is not None:
            result["security_bulletin"] = match.group().upper()

    # Prefer newer CVSS versions, fall back to older ones
    metrics = vulnerability.get("metrics", {})
    for key in ("cvssMetricV31", "cvssMetricV30", "cvssMetricV2"):
        for source in metrics.get(key, []):
            if (
                source.get("source") == "nvd@nist.gov"
                and source.get("type") == "Primary"
            ):
                result["base_score"] = source["cvssData"]["baseScore"]
                result["exploitability_score"] = source.get("exploitabilityScore")
                result["impact_score"] = source.get("impactScore")
                return result

    return result


def query_github_api(*terms: str | None) -> dict:
    cleaned = [term for term in terms if term]

    query = " OR ".join(cleaned)
    response = requests.get(
        url="https://api.github.com/search/repositories",
        params={"q": query, "sort": "stars"},
        headers={"Accept": "application/vnd.github+json"},
        timeout=30,
    )
    response.raise_for_status()

    data = response.json()

    if "message" in data:
        raise RuntimeError(f"GitHub API error: {data['message']}")

    items = data["items"]
    return {
        "repositories": data["total_count"],
        "highest_stars": items[0]["stargazers_count"] if items else None,
    }


def query(cves: list) -> list:
    aggregated = []

    for cve in cves:
        nvd_data = query_nvd_api(cve)

        if nvd_data["base_score"] is None:
            continue

        security_bulletin = nvd_data["security_bulletin"]

        github_data = query_github_api(cve, security_bulletin)

        aggregated.append(
            {
                "CVE": cve,
                "security_bulletin": security_bulletin,
                "base_score": nvd_data["base_score"],
                "exploitability_score": nvd_data["exploitability_score"],
                "impact_score": nvd_data["impact_score"],
                "repositories": github_data["repositories"],
                "highest_stars": github_data["highest_stars"],
            }
        )

        # Both APIs limit unauthenticated users to 10 requests/min
        time.sleep(6)

    # Sort by total_count desc
    aggregated.sort(key=lambda cve: cve["repositories"] or 0, reverse=True)

    return aggregated


def print_results(aggregated: list) -> None:
    for vulnerability in aggregated:
        header = vulnerability["CVE"]
        if vulnerability["security_bulletin"]:
            header += f" / {vulnerability['security_bulletin']}"

        print(header)
        print(f"  Repositories: {vulnerability['repositories']}")
        print(f"  Highest stars: {vulnerability['highest_stars']}")
        print(f"  Base Score: {vulnerability['base_score']}")
        print(f"  Exploitability score: {vulnerability['exploitability_score']}")
        print(f"  Impact score: {vulnerability['impact_score']}")
        print()


def main():
    args = parse_args()
    cves = read_file(args.file)
    aggregated = query(cves)
    print_results(aggregated)


if __name__ == "__main__":
    main()
